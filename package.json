{
  "name": "l9it",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm start",
    "backend": "cd backend && php -S localhost:8000 -t public",
    "docker:up": "cd docker && docker compose -f docker-compose.yml up -d",
    "docker:dev": "cd docker && docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "cd docker && docker compose down"
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}
