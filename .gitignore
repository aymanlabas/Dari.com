.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Docker
docker-compose.override.yml

# Database
*.sqlite
*.db

# Test coverage
coverage/
.nyc_output

# Temporary
tmp/
temp/
*.pid
