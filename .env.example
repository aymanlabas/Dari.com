# Environment variables for L9it

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=l9it
DB_USERNAME=l9it
DB_PASSWORD=l9it
DB_ROOT_PASSWORD=root

DATABASE_URL=mysql://l9it:l9it@db:3306/l9it

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-secure-random-key

# App
APP_ENV=dev
APP_DEBUG=true
APP_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_PORT=3000

# File Upload
MAX_IMAGE_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
