{
  "name": "L9it API",
  "shortName": "l9it",
  "description": "Moroccan Classified Marketplace API",
  "version": "1.0.0",
  "api": {
    "openapi": "3.0.3",
    "info": {
      "title": "L9it API",
      "version": "1.0.0",
      "description": "The REST API for the L9it Moroccan classified marketplace"
    },
    "servers": [
      {
        "url": "/api",
        "description": "Development server"
      }
    ],
    "paths": {
      "/auth/register": {
        "post": {
          "summary": "Register a new user",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "firstName": { "type": "string" },
                    "lastName": { "type": "string" },
                    "email": { "type": "string" },
                    "phone": { "type": "string" },
                    "password": { "type": "string" }
                  },
                  "required": ["firstName", "lastName", "email", "phone", "password"]
                }
              }
            }
          }
        }
      },
      "/auth/login": {
        "post": {
          "summary": "Authenticate user",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": { "type": "string" },
                    "password": { "type": "string" }
                  },
                  "required": ["email", "password"]
                }
              }
            }
          }
        }
      }
    }
  }
}
