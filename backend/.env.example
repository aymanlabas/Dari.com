# L9it Environment Configuration
# Copy this file to .env and fill in the values

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=l9it_dev
DB_USERNAME=l9it
DB_PASSWORD=l9it
DB_ROOT_PASSWORD=root

DATABASE_URL=mysql://l9it:l9it@localhost:3306/l9it_dev

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_TTL=3600

# Application
APP_ENV=dev
APP_DEBUG=true
APP_PORT=8000

# Redis (optional, for caching and sessions)
REDIS_URL=redis://localhost:6379

# Email (for password reset)
MAIL_FROM_ADDRESS=contact@l9it.ma
MAIL_FROM_NAME="L9it"
MAIL_TRANSPORT=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=

# File Upload
MAX_IMAGE_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CDN (optional)
CDN_URL=
